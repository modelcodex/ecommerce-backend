// Prisma Schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================
// ENUMS
// ============================

enum Role {
  USER
  ADMIN
  STAFF
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

// ===========================
// USER MODEL
// ===========================

model User {
  id String @id @default(cuid(2))

  firstName String
  lastName  String

  email        String  @unique
  passwordHash String?

  avatar     String?
  providerId String?

  role     Role         @default(USER)
  provider AuthProvider @default(EMAIL)

  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  isDeleted       Boolean   @default(false)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  carts                   Cart[]

  @@index([email])
  @@index([role])
}

// =======================
// SESSION MODEL
// =======================

model Session {
  id     String @id @default(cuid(2))
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?
  ipAddress String?

  revokedAt DateTime?
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([revokedAt])
  @@index([expiresAt])
}

// =============================
// REFRESH TOKEN MODEL
// =============================

model RefreshToken {
  id String @id @default(cuid(2))

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([revokedAt])
}

// ===================================
// EMAIL VERIFICATION TOKEN MODEL 
// ===================================

model EmailVerificationToken {
  id String @id @default(cuid(2))

  userId    String
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================
// PASSWORD TOKEN MODLE 
// =============================

model PasswordResetToken {
  id String @id @default(cuid(2))

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// =====================
// CATEGORY MODLE
// =====================

model Category {
  id String @id @default(cuid(2))

  name        String
  slug        String  @unique
  description String?

  imageUrl String?

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products        Product[]
  metaTitle       String?
  metaDescription String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([parentId])
  @@index([parentId, isActive])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

// =====================
// BRAND MODEL
// =====================

model Brand {
  id String @id @default(cuid(2))

  name        String  @unique
  slug        String  @unique
  description String?

  logoUrl String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([deletedAt])
}

// =====================
// PRODUCT MODEL
// =====================

model Product {
  id String @id @default(cuid(2))

  name             String
  slug             String  @unique
  shortDescription String?
  description      String?

  model               String?
  manufacturer        String?
  warrantyPeriod      Int? // Duration in months
  warrantyDescription String?
  tags                String[] @default([])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  sortOrder Int @default(0)

  metaTitle       String?
  metaDescription String?

  variants ProductVariant[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([categoryId])
  @@index([categoryId, isPublished])
  @@index([brandId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([sortOrder])
  @@index([deletedAt])
}

// ============================
// PRODUCT VARIANT MODEL
// ============================

model ProductVariant {
  id String @id @default(cuid(2))

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  images ProductImage[]

  sku     String  @unique
  barcode String? @unique

  name            String?
  countryOfOrigin String?
  color           String?
  size            String?
  weight          Decimal? @db.Decimal(10, 2)
  length          Decimal? @db.Decimal(10, 2)
  width           Decimal? @db.Decimal(10, 2)
  height          Decimal? @db.Decimal(10, 2)
  description     String?

  price     Decimal  @db.Decimal(10, 2)
  costPrice Decimal? @db.Decimal(10, 2)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  trackInventory Boolean @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory?
  cartItems CartItem[]

  @@index([productId])
  @@index([productId, isActive])
  @@index([isDefault])
  @@index([isActive])
  @@index([deletedAt])
}

// ====================
// PRODUCT IMAGE MODEL
// ====================

model ProductImage {
  id String @id @default(cuid(2))

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  imageUrl String
  altText  String?

  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId])
  @@index([isPrimary])
  @@index([sortOrder])
}

// =======================
// INVENTORY MODEL
// =======================

model Inventory {
  id String @id @default(cuid(2))

  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity         Int @default(0)
  reservedQuantity Int @default(0)

  allowBackorder Boolean @default(false)

  lowStockAlert Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quantity])
}

// =====================
// CART MODEL
// =====================

model Cart {
  id String @id @default(cuid(2))

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guestTokenHash String? @unique

  items CartItem[]

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// CART ITEM MODEL
// =====================

model CartItem {
  id String @id @default(cuid(2))

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}
